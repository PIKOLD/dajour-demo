# Скопируйте этот файл в .env (в той же папке) и впишите ключи. Файл .env никому не отправляйте и не коммитьте.

# Telegram: создайте бота у @BotFather → /newbot → токен
TELEGRAM_BOT_TOKEN=
# Куда бот шлёт заявки на перманент и уведомления о записях (ваш chat id; узнать — написать боту @userinfobot)
ADMIN_CHAT_ID=

# YandexGPT (Yandex Cloud AI Studio): API-ключ сервисного аккаунта с ролью ai.languageModels.user и ID каталога
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# модель: yandexgpt/latest (Pro) или yandexgpt-lite/latest (дешевле)
YANDEX_MODEL=yandexgpt/latest

# YCLIENTS: партнёрский токен (кабинет разработчика) и ID филиала (число в адресе админки)
YCLIENTS_PARTNER_TOKEN=
YCLIENTS_COMPANY_ID=
# заполнит скрипт get_yclients_token.py
YCLIENTS_USER_TOKEN=
